# ============================================
# SUPER MITRE - BACKEND ENVIRONMENT VARIABLES
# ============================================
# COPIA este archivo a .env y completa los valores
# NUNCA comitees .env al repositorio
# ============================================

# --- Database ---
DB_HOST=localhost
DB_NAME=supermitre_db
DB_USER=db_user
DB_PASSWORD=CambiarEstaPass123!

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=generar_clave_segura_aqui_min_32_caracteres

# --- Código Admin para registro de usuarios privilegiados ---
# Cambiar por un valor único y seguro
ADMIN_CODE=Cambiar_ADMIN_CODE_AQUI

# --- MercadoPago - Pagos online (pasarela checkout) ---
MP_ONLINE_ACCESS_TOKEN=APP_USR-

# --- MercadoPago - QR caja (pagos presenciales) ---
MP_QR_ACCESS_TOKEN=APP_USR-
MP_PUBLIC_KEY=APP_USR-
MP_USER_ID=
MP_STORE_ID=
MP_POS_EXTERNAL_ID=CAJA001

# --- WhatsApp ---
WHATSAPP_NUMERO_DUENO=5491112345678

# --- MercadoPago Webhook Secret ---
MP_WEBHOOK_SECRET=

# --- AFIP/ARCA ---
AFIP_CUIT=20304684012
AFIP_PTO_VTA=1
AFIP_MODE=homologacion

# --- Server ---
PORT=5000
NODE_ENV=development
